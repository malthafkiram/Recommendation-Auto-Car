# ─── Server ───
PORT=5001

# ─── MongoDB ───
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=rac-ai

# ─── Auth ───
JWT_SECRET=change-me-min-32-characters-random-string

# ─── Google ───
GOOGLE_CLIENT_ID=123456789-abcdef.apps.googleusercontent.com
GOOGLE_PLACES_API_KEY=

# ─── AI (Groq) ───
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b

# ─── Midtrans (sandbox) ───
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx
MIDTRANS_IS_PRODUCTION=false
PREMIUM_MONTHLY_PRICE=99000

# ─── Car sync (opsional / bonus AL-04) ───
CARAPI_NINJA_KEY=
SYNC_SECRET=

# ─── CORS ───
# Local:
CORS_ORIGIN=http://localhost:5173
# Production (uncomment, ganti URL FE deploy):
# CORS_ORIGIN=https://rac-ai.vercel.app

# ─── Integration test (LOCAL ONLY — jangan set di production) ───
TEST_BASE_URL=http://localhost:5001
SKIP_GOOGLE_TEST=1
# GOOGLE_ID_TOKEN=
# INTEGRATION_AI_DELAY_MS=12000
# INTEGRATION_PREMIUM_DELAY_MS=15000